{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/auto-commit-push.mjs\"",
            "commandWindows": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/auto-commit-push.mjs\"",
            "timeout": 120,
            "statusMessage": "Committing and pushing Codex changes"
          }
        ]
      }
    ]
  }
}
