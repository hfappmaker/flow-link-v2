# ---------------------------------------------------------------------------
# データベース (Prisma Postgres)
# Vercel Marketplace で Prisma Postgres を作成し、接続文字列を設定してください。
# ローカル開発では `npx prisma dev` で起動するローカルPrisma Postgresも利用できます。
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/flowlink"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# `npx auth secret` で生成できます。Vercelにも同じ値を設定してください。
# ---------------------------------------------------------------------------
AUTH_SECRET=""

# 本番環境のURL（Vercelでは自動設定されるため通常は不要）
# AUTH_URL="https://your-app.vercel.app"

# ---------------------------------------------------------------------------
# OAuthプロバイダ（設定したものだけログインボタンが表示されます）
# ---------------------------------------------------------------------------
# Google: https://console.cloud.google.com/apis/credentials
# コールバックURL: {ORIGIN}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub: https://github.com/settings/developers
# コールバックURL: {ORIGIN}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Microsoft Entra ID: https://portal.azure.com (アプリの登録)
# コールバックURL: {ORIGIN}/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# 個人アカウントも許可する場合は common、組織のみの場合はテナントIDを含むURLに変更
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"

# ---------------------------------------------------------------------------
# メール送信 (Resend)
# Resend の API キーを設定してください。検証済みドメインがない開発中は
# `FlowLink <onboarding@resend.dev>` を送信元として利用できます。
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="FlowLink <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# File storage (Vercel Blob)
# 履歴書・職務経歴書などの永続保存に使います。
# Vercel Blob store を project に接続すると Vercel 側で自動設定されます。
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# メール本文内のリンク生成に利用します。未設定時は AUTH_URL / Vercel URL /
# http://localhost:3000 の順にフォールバックします。
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Deployment Protection bypass for preview smoke-check automation.
# Keep the real bypass secret only in local/automation env files, never in git.
VERCEL_AUTOMATION_BYPASS_SECRET=""

# Optional credentials for preview smoke-check automation login coverage.
# Use a non-production test account only.
FLOWLINK_SMOKE_TEST_EMAIL=""
FLOWLINK_SMOKE_TEST_PASSWORD=""
